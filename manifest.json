{
  "id": "curate",
  "name": "Curate",
  "description": "Review BDH session-synthesis and legacy candidate proposals",
  "version": "1.4.0",
  "enabled": true,
  "routePath": "/curate",
  "navItem": {
    "to": "/curate",
    "label": "nav.curate",
    "icon": "Brain",
    "order": 60,
    "indicator": {
      "endpoint": "/curate/status",
      "pollMs": 30000,
      "tones": ["neutral", "info", "success", "warning", "error"]
    }
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/curate/status",
      "handler": "curateStatus",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/candidates",
      "handler": "listCandidates",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/candidates/vaults",
      "handler": "listVaults",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/candidates/approve",
      "handler": "approveCandidate",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/candidates/reject",
      "handler": "rejectCandidate",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/synthesis/activity",
      "handler": "listSynthesisActivity",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/synthesis/candidates",
      "handler": "listSynthesisCandidates",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/synthesis/apply",
      "handler": "applySynthesisCandidate",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/synthesis/merge-targets",
      "handler": "listMergeTargets",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/synthesis/merge-preview",
      "handler": "previewSynthesisMerge",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/synthesis/merge",
      "handler": "mergeSynthesisCandidate",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/synthesis/reject",
      "handler": "rejectSynthesisCandidate",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/synthesis/revert",
      "handler": "revertSynthesis",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/candidates/clustered",
      "handler": "listClusteredCandidates",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/candidates/restore",
      "handler": "restoreAutoRejectedCandidate",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/candidates/classify",
      "handler": "classifyPendingCandidates",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/curate/advise",
      "handler": "startAdvice",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/curate/advise/status",
      "handler": "adviceStatus",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/curate/advise/active",
      "handler": "activeAdvice",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/curate/accept/plan",
      "handler": "planAccept",
      "authRequired": true
    },
    {
      "method": "POST",
      "path": "/curate/accept",
      "handler": "startAccept",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/curate/accept/status",
      "handler": "acceptStatus",
      "authRequired": true
    },
    {
      "method": "GET",
      "path": "/curate/accept/active",
      "handler": "activeAccept",
      "authRequired": true
    }
  ]
}
